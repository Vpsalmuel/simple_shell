# Gemini API key for Rex AI (server-side only). Get one from Google AI Studio.
GEMINI_API_KEY=
# Optional: override the model (defaults to the AI Studio prototype's model).
GEMINI_MODEL=
# Optional: server port (default 3001).
PORT=3001

# Microsoft single sign-on (Microsoft Entra ID app registration, type "Single-page application").
# Redirect URI to register: your site's origin, e.g. https://hub.rexinsurance.com
# Leave empty to run Rex Hub in demo mode with a persona picker.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
